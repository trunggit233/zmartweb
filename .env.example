# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN (ZMARTWEB LANDING PAGE)
# Sao chép file này thành .env.local (ở máy cá nhân) hoặc .env (trên VPS)
# ==============================================================================

# 1. THÔNG TIN WEBSITE & DOMAIN
NEXT_PUBLIC_SITE_NAME="ZmartWeb"
NEXT_PUBLIC_SITE_URL="https://zmartweb.com"
NEXT_PUBLIC_HOTLINE=""
NEXT_PUBLIC_CONTACT_EMAIL="contact@zmartweb.com"
NEXT_PUBLIC_ADDRESS="Hà Nội, Việt Nam"

# 2. BẢO MẬT & RATE LIMIT FORM ĐẶT LỊCH
# Số lượt gửi form tối đa từ 1 IP trong vòng 1 phút (Mặc định: 5)
RATE_LIMIT_MAX_REQUESTS=5

# 3. KÊNH THÔNG BÁO 1: TELEGRAM BOT (KHUYÊN DÙNG - MIỄN PHÍ 100%)
# Nhận tin nhắn thông báo "ting ting" về điện thoại ngay khi có khách đặt lịch
# - Tạo bot qua @BotFather trên Telegram để lấy TELEGRAM_BOT_TOKEN
# - Lấy TELEGRAM_CHAT_ID của bạn hoặc nhóm chat qua bot @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 4. KÊNH THÔNG BÁO 2: GOOGLE SHEETS WEBHOOK (TỰ ĐỘNG GHI DANH SÁCH KHÁCH)
# Nhập URL Webhook từ Google Apps Script (nếu có)
GOOGLE_SHEET_WEBHOOK_URL=""

# 5. KÊNH THÔNG BÁO 3: GỬI EMAIL THÔNG BÁO (RESEND HOẶC SMTP)
# Dùng dịch vụ Resend (https://resend.com - miễn phí 3.000 mail/tháng)
RESEND_API_KEY=""
EMAIL_FROM="ZmartWeb <booking@zmartweb.com>"
EMAIL_ADMIN_RECEIVE="admin@zmartweb.com"
